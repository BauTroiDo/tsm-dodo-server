# Auto detect text files
* text=auto

# Source code - giữ LF trong repository
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.lua   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.properties text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf

# Windows scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Game / binary data - Git không được đổi newline
*.dat   binary
*.emg   binary
*.unity3d binary
*.apk   binary
*.dll   binary
*.exe   binary
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ogg   binary
*.mp3   binary
*.wav   binary
