<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/tsm_dodo.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/tsm_dodo.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Giảm mức ghi log Netty -->
    <logger name="io.netty" level="WARN"/>

    <!-- Ghi log Exposed SQL(INFO sẽ ghi lại từng câu SQL,môi trường sản xuất dùng WARN) -->
    <logger name="Exposed" level="WARN"/>

    <!-- Hạ mức nhiễu tần suất cao -->
    <logger name="tw.tsm.gamelogic.systems.WorldManager" level="INFO"/>
    <logger name="tw.tsm.network.PacketDispatchHandler" level="INFO"/>
    <logger name="tw.tsm.app.handlers.BattleCommandHandler" level="INFO"/>

    <!-- Chẩn đoán đánh giá điều kiện sự kiện(hiển thị kết quả xét class/param/ops điều kiện) -->
    <logger name="tw.tsm.gamelogic.systems.EveConditionEvaluator" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
