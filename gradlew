#!/bin/sh

##############################################################################
# Gradle start up script for POSIX generated by Gradle.
##############################################################################

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
DIRNAME=$(dirname "$0")

# Resolve links
while [ -h "$DIRNAME/$APP_BASE_NAME" ]; do
    ls=$(ls -ld "$DIRNAME/$APP_BASE_NAME")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        APP_BASE_NAME="$link"
    else
        DIRNAME="$DIRNAME/$(dirname "$link")"
        APP_BASE_NAME="$(basename "$link")"
    fi
done

APP_HOME=$(cd "$DIRNAME" && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec java $JAVA_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
